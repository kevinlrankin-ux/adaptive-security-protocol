{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-security-protocol.local/schemas/pqc-vault-boundary-manifest.schema.json",
  "title": "PQC Vault Boundary Manifest Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "boundary_id",
    "created_at",
    "wrapping"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "const": "pqc-vault.portable-post-quantum-boundary"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "boundary_id": {
      "type": "string",
      "minLength": 16
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "wrapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "const": "post-quantum-protected"
        },
        "algorithm": {
          "type": "string"
        },
        "recipient_key_id": {
          "type": "string"
        }
      }
    }
  }
}
